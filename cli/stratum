#!/usr/bin/env bash
# stratum — start, stop and inspect the Stratum shell.
#
# The lifecycle half of the CLI. `stratumctl` talks to a shell that is already
# running; this one decides whether it is running at all.
set -euo pipefail

CONFIG=stratum
PATTERN="qs -c $CONFIG"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/stratum/shell.log"

say()  { printf '  %s\n' "$1"; }
die()  { printf '  %s\n' "$1" >&2; exit 1; }

# pgrep -f matches this script's own command line, and the shell that invoked it,
# so both are excluded explicitly. Without that, `stratum status` reports a
# running shell whenever it is asked.
pids() {
  pgrep -f "$PATTERN" 2>/dev/null | grep -vx -e "$$" -e "$PPID" || true
}

running() { [ -n "$(pids)" ]; }

start() {
  running && { say "already running"; return 0; }
  command -v qs >/dev/null || die "quickshell is not installed"
  mkdir -p "$(dirname "$LOG")"
  # Detached with its own log, so the shell outlives the terminal that
  # started it and there is somewhere to look when it does not.
  # In its own session with no terminal at all: nothing the shell does can
  # reach the prompt that started it.
  setsid -f qs -c "$CONFIG" </dev/null >>"$LOG" 2>&1
  sleep 1
  running && say "started" || die "failed to start — see: stratum log"
}

stop() {
  running || { say "not running"; return 0; }
  # SIGTERM first: Quickshell releases its layer surfaces on the way out, and
  # killing it outright can leave the compositor holding them.
  pids | xargs -r kill
  for _ in $(seq 20); do
    running || { say "stopped"; return 0; }
    sleep 0.1
  done
  pids | xargs -r kill -9
  say "stopped (forced)"
}

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Everything that has to be true for the shell to work, checked and explained.
doctor() {
  local bad=0
  good() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
  poor() { printf '  \033[33m!\033[0m %s\n' "$1"; bad=1; }
  tool() {
    if command -v "$1" >/dev/null; then good "$1 — $2"; else poor "$1 missing — $2"; fi
  }

  echo "  Stratum $(git -C "$ROOT" log -1 --format='%h (%cs)' 2>/dev/null) on branch $(git -C "$ROOT" branch --show-current 2>/dev/null)"
  if git -C "$ROOT" fetch -q 2>/dev/null; then
    local behind; behind=$(git -C "$ROOT" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
    [ "$behind" -gt 0 ] && poor "$behind update(s) waiting — run: stratum update" || good "up to date"
  fi
  running && good "shell running" || poor "shell not running — stratum start"

  tool qs "quickshell, the runtime"
  # Quickshell says this itself, at the top of every run, when Qt has been
  # updated under it; it is the usual cause of crashes nothing else explains.
  if grep -q "without rebuilding the package" "$LOG" 2>/dev/null && \
     [ "$(grep -n "without rebuilding" "$LOG" | tail -n1 | cut -d: -f1)" -gt "$(( $(wc -l < "$LOG") - 400 ))" ]; then
    poor "Quickshell was built for an older Qt than you now have — rebuild it: paru -S --rebuild quickshell"
  fi
  tool grim "screenshots"; tool slurp "region select"; tool satty "screenshot annotation"
  tool wl-copy "clipboard (launcher calculator)"
  tool wpctl "volume (pipewire)"
  tool brightnessctl "laptop backlight"; tool ddcutil "external monitor brightness"
  tool powerprofilesctl "power profiles"; tool hyprsunset "night light"
  tool gpu-screen-recorder "screen recording"; tool matugen "colours from the wallpaper"
  tool plocate "launcher file search (falls back to find)"
  tool zenity "file chooser in settings"
  command -v rembg >/dev/null && good "rembg — wallpaper depth" || printf '  · rembg not installed (optional: wallpaper depth)\n'

  # A wallpaper folder with nothing in it is a black desktop.
  local walls
  walls=$(qs -c "$CONFIG" ipc call config get wallpaper.dir 2>/dev/null | tr -d '"')
  walls=${walls:-$HOME/Pictures/Wallpapers}
  walls=${walls/#\~/$HOME}
  if [ -d "$walls" ]; then
    local n; n=$(find -L "$walls" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && good "$n wallpapers in $walls" || poor "no pictures in $walls — the desktop will be blank; run install.sh again for the ones Stratum ships"
  else
    poor "no wallpaper folder at $walls — the desktop will be blank"
  fi

  # The keybinds only work if Hyprland loads the file Stratum writes.
  local hypr="${XDG_CONFIG_HOME:-$HOME/.config}/hypr" cfg file
  if [ -f "$hypr/hyprland.lua" ]; then cfg="$hypr/hyprland.lua"; file="$hypr/stratum-binds.lua"
  else cfg="$hypr/hyprland.conf"; file="$hypr/stratum-binds.conf"; fi
  [ -f "$file" ] && good "binds file $file" || poor "no binds file — run the installer, or open Settings → Keybinds"
  if grep -rqF "stratum-binds" "$hypr" --include='*.lua' --include='*.conf' --exclude='stratum-binds.*' 2>/dev/null; then
    good "Hyprland loads the binds file"
  else
    poor "Hyprland does not load $file — add it to $cfg (see docs/TROUBLESHOOTING.md)"
  fi
  if command -v hyprctl >/dev/null; then
    hyprctl binds 2>/dev/null | grep -q "stratum:launcher\|apps open\|launcher" \
      && good "launcher key is bound" || poor "no launcher key bound in Hyprland — reload Hyprland, or bind one in Settings → Keybinds"
  fi
  if command -v ddcutil >/dev/null && ! id -nG | grep -qw i2c && getent group i2c >/dev/null; then
    poor "not in the i2c group — external monitor brightness needs: sudo usermod -aG i2c $USER (then log out and in)"
  fi

  [ "$bad" = 0 ] && echo "  all good" || echo "  see docs/TROUBLESHOOTING.md for each of these"
  return $bad
}

update() {
  git -C "$ROOT" pull --ff-only || die "could not update — local changes? see: git -C $ROOT status"
  running && { stop; start; } || say "updated — start it with: stratum start"
}

case "${1:-help}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)
    if running; then
      say "running — pid $(pids | tr '\n' ' ')"
    else
      say "not running"
      exit 1
    fi
    ;;
  # The last lines and back to the prompt; -f (or --follow) keeps watching.
  log)
    mkdir -p "$(dirname "$LOG")"; touch "$LOG"
    case "${2:-}" in
      -f|--follow) tail -n "${3:-60}" -f "$LOG" ;;
      *)           tail -n "${2:-60}" "$LOG" ;;
    esac ;;
  # Only the shell's own trace lines, from the live instance rather than the
  # start-up log. `stratum log` drowns these in compositor warnings, which is
  # what made the first attempt at reading them useless.
  trace)   qs -c "$CONFIG" log 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep '\[trace\]' | tail -n "${2:-40}" ;;
  ipc)     shift; exec qs -c "$CONFIG" ipc call "$@" ;;
  doctor)  doctor ;;
  update)  update ;;
  *)
    cat <<USAGE

  stratum — run the Stratum shell

    stratum start              start it, detached, logging to
                               $LOG
    stratum stop
    stratum restart
    stratum status             exit 0 if running
    stratum log [N]            the last N lines of the log (default 60)
    stratum log -f             keep watching it
    stratum trace [N]          just the shell's trace lines
    stratum ipc ...            raw IPC, e.g. stratum ipc panel toggle control
    stratum doctor             check everything it needs, and say what is wrong
    stratum update             pull the latest version and restart

  See also: stratumctl (panels), shellctl (switch between installed shells)

USAGE
    ;;
esac
